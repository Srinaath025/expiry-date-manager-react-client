# Expiry Date Manager - React Client (Vite) Environment Configurations

# URL pointing to the backend API server.
#
# - Local Dev (using Vite Proxy): Leave blank. Requests to /auth and /products will be proxied
#   automatically to http://localhost:5001 according to vite.config.js.
#
# - Production (Netlify): Set this to the backend API URL deployed on Render.
#   Example: VITE_API_URL=https://expiry-date-express-server.onrender.com
VITE_API_URL=https://expiry-date-express-server-6npz.onrender.com/
